# Wallet used by scripts/deploy.mjs and scripts/e2e.mjs. Generate one with `npm run wallet:new`.
# NEVER commit the real .env file.
PRIVATE_KEY=0x...
WALLET_ADDRESS=0x...
GENLAYER_RPC_URL=https://studio.genlayer.com/api
