{
  "name": "wallai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WallAI - an AI-moderated social wall on GenLayer Studionet",
  "scripts": {
    "wallet:new": "node scripts/create-wallet.mjs",
    "deploy:studionet": "node scripts/deploy.mjs",
    "e2e:studionet": "node scripts/e2e.mjs",
    "lint:contract": "genvm-lint check contracts/wall_ai.py",
    "test:contract": "pytest tests/direct/ -v",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "probe:appeal": "node scripts/appeal-probe.mjs"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "genlayer-js": "1.1.8"
  }
}
